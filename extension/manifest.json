{
  "manifest_version": 3,
  "name": "Interlude — Your media, between prompts",
  "version": "0.4.0",
  "key": "",
  "description": "Pause your chosen media tab when Codex needs attention. Pair with the local Interlude companion.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Interlude"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "media.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:4318"
  },
  "optional_host_permissions": [
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://m.facebook.com/*",
    "https://web.facebook.com/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://mobile.twitter.com/*",
    "https://www.reddit.com/*",
    "https://reddit.com/*",
    "https://old.reddit.com/*",
    "https://new.reddit.com/*",
    "https://www.twitch.tv/*",
    "https://twitch.tv/*",
    "https://player.twitch.tv/*",
    "https://vimeo.com/*",
    "https://www.vimeo.com/*",
    "https://player.vimeo.com/*",
    "https://www.netflix.com/*",
    "https://netflix.com/*",
    "https://www.primevideo.com/*",
    "https://primevideo.com/*",
    "https://www.disneyplus.com/*",
    "https://disneyplus.com/*",
    "https://www.hulu.com/*",
    "https://hulu.com/*",
    "https://www.hbomax.com/*",
    "https://hbomax.com/*",
    "https://play.hbomax.com/*",
    "https://www.max.com/*",
    "https://max.com/*",
    "https://play.max.com/*",
    "https://tv.apple.com/*",
    "https://www.peacocktv.com/*",
    "https://peacocktv.com/*",
    "https://www.paramountplus.com/*",
    "https://paramountplus.com/*",
    "https://open.spotify.com/*",
    "https://music.apple.com/*",
    "https://soundcloud.com/*",
    "https://www.soundcloud.com/*"
  ],
  "version_name": "0.3.1 beta 2"
}
